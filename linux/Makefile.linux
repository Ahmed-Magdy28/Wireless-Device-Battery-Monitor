# Linux (Ubuntu / Debian / Fedora) build. Kept separate from the Windows Makefile so the existing
# MinGW build stays untouched. GIO provides the StatusNotifierItem tray icon over D-Bus and Cairo
# renders the icon; HID access goes straight to hidraw, so no extra HID library is needed.
#
# Ubuntu/Debian: sudo apt install g++ make libgtk-3-dev libcairo2-dev
# Fedora:        sudo dnf install gcc-c++ make gtk3-devel cairo-devel
#
# ./build-linux.sh          (from the repository root; same as: make -f linux/Makefile.linux)
# ./build-linux.sh deb      (build a .deb package in dist/)
# ./build-linux.sh clean

CXX      ?= g++
PKGCONFIG ?= pkg-config
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wno-missing-field-initializers
GIO_CFLAGS := $(shell $(PKGCONFIG) --cflags gtk+-3.0 gio-2.0 cairo)
GIO_LIBS   := $(shell $(PKGCONFIG) --libs gtk+-3.0 gio-2.0 cairo)

# Phase 1: famous vendors whose drivers only need the portable HID API.
DRIVERS := \
    src/drivers/glorious.cpp \
    src/drivers/kysona.cpp \
    src/drivers/logitech.cpp \
    src/drivers/razer.cpp \
    src/drivers/steelseries.cpp \
    src/drivers/corsair.cpp \
    src/drivers/hyperx.cpp \
    src/drivers/playstation.cpp \
    src/drivers/coolermaster.cpp \
    src/drivers/finalmouse.cpp

SRC := src/linux/hid_linux.cpp src/linux/devices_linux.cpp src/linux/main_linux.cpp $(DRIVERS)
OBJ := $(patsubst src/%.cpp,build/linux/%.o,$(SRC))
TARGET := wireless-battery

$(TARGET): $(OBJ)
	$(CXX) $^ -o $@ $(GIO_LIBS) -pthread

build/linux/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(GIO_CFLAGS) -c $< -o $@

test:
	@mkdir -p build/linux
	$(CXX) $(CXXFLAGS) tests/linux_hid_test.cpp -o build/linux/linux_hid_test
	./build/linux/linux_hid_test

deb:
	./linux/build-deb.sh

clean:
	rm -rf build/linux build/deb $(TARGET)

.PHONY: clean test deb
